              "lockfile",
              "override",
              "manual",
              "dev-only"
            ]
          },
          "risk": {
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 300
          },
          "impact": {
            "type": "string",
            "maxLength": 800
          },
          "usage": {

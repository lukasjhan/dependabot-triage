                  "type": "string"
                },
                "line": {
                  "type": "integer"
                },
                "note": {
                  "type": "string",
                  "maxLength": 200
                }
              }
            }
          },
          "action": {
            "type": "string",
            "maxLength": 500
          },
          "breakingChanges": {
            "type": "array",
            "maxItems": 5,
            "items": {
